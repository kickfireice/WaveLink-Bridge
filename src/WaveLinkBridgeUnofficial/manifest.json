{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "com.kickfireice.wavelink-bridge",
  "name": "WaveLink Bridge",
  "version": "1.0.16",
  "description": "Unofficial Elgato Wave Link 3 control for Macro Deck 3. Set volumes, mutes, mixes, inputs, outputs and effects.",
  "icon": "Assets/icon.png",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/WaveLinkBridgeUnofficial.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    },
    "osx-arm64": {
      "executable": "runtimes/osx-arm64/WaveLinkBridgeUnofficial.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    }
  },
  "publisher": {
    "name": "Kick Fire"
  },
  "license": "MIT",
  "ai": {
    "interaction": false,
    "generatedContent": false,
    "generatedAssets": true
  },
  "repository": "https://github.com/kickfireice/WaveLink-Bridge",
  "compatibility": {
    "macroDeck": ">=3.0.0-0"
  }
}